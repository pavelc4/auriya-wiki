---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DraftContentNotice from '@astrojs/starlight/components/DraftContentNotice.astro';
import { LinkButton, Icon } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const isId = Astro.url.pathname.startsWith('/id');
const is404 =
	data.title === '404' ||
	title === '404' ||
	Astro.locals.starlightRoute?.entry?.id === '404' ||
	Astro.locals.starlightRoute?.entry?.slug === '404' ||
	Astro.url.pathname === '/404' ||
	Astro.url.pathname === '/404/' ||
	Astro.url.pathname === '/id/404' ||
	Astro.url.pathname === '/id/404/';

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	fetchpriority: 'high' as const,
	width: 320,
	height: 320,
	alt: image?.alt || 'Kurukuru Mascot',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id="_top" data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}

			{
				!is404 && (
					<div class="hero-note-inline">
						<div class="hero-note-header">
							<Icon name="rocket" class="hero-note-icon-svg" />
							<span>{isId ? 'Catatan Pembelajaran & Riset Pribadi' : 'Educational & Research Disclaimer'}</span>
						</div>
						<div class="hero-note-content">
							<p>
								{isId
									? 'Proyek Auriya dan seluruh dokumentasi teknis ini dibuat semata-mata sebagai sarana riset mandiri, eksplorasi optimasi performa Android root, serta pembelajaran pribadi.'
									: 'This project and its technical documentation are developed purely for personal learning, architectural exploration, and Android kernel/userspace optimization research.'}
							</p>
						</div>
					</div>
				)
			}
		</div>
		{
			actions.length > 0 ? (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			) : is404 ? (
				<div class="sl-flex actions">
					<LinkButton href={isId ? '/id/' : '/'} variant="primary" icon="right-arrow">
						{isId ? 'Kembali ke Beranda' : 'Back to Home'}
					</LinkButton>
				</div>
			) : null
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 0.25rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		.hero-title {
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 800;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: var(--sl-text-body-lg);
			line-height: var(--sl-line-height);
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 1.25rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: clamp(2.5rem, calc(2.5rem + 2vw), 4rem);
				padding-block: clamp(2.5rem, calc(2.5rem + 2vw), 4rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
